                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "point"
                      },
                      "x": {
                        "description": "Position on the x axis, in the x column's own values",
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "description": "Short note, a few words"
                      }
                    },
                    "required": [
                      "kind",
                      "x",
                      "label"
                    ],
                    "additionalProperties": false,
                    "description": "Marks a single x position"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "range"
                      },
                      "from": {
                        "description": "Start of the range on the x axis, in the x column's own values",
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "to": {
                        "description": "End of the range, inclusive",
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "description": "Short note, a few words"
                      }
                    },
                    "required": [
                      "kind",
                      "from",
                      "to",
                      "label"
                    ],
                    "additionalProperties": false,
                    "description": "Shades a span of the x axis"
                  }
                ],
                "description": "A note that draws attention to part of the chart"
              }
            }
          },
