      "oneOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1,
              "description": "Always 1"
            },
            "title": {
              "type": "string",
              "description": "States what the chart shows, in plain words"
            },
            "subtitle": {
              "description": "Extra context: units, date range, data caveats",
              "type": "string"
            },
            "filters": {
              "description": "Up to 5 row filters",
              "maxItems": 5,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "description": "Exact column name from the dataset summary"
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "neq",
                          "gt",
                          "gte",
                          "lt",
                          "lte"
                        ],
                        "description": "eq =, neq ≠, gt >, gte ≥, lt <, lte ≤"
                      },
                      "value": {
                        "description": "A value from the column: a number, a category label, or an ISO 8601 date string such as \"2025-06-19\"",
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "op",
                      "value"
                    ],
                    "additionalProperties": false,
                    "description": "Keep rows where the field compares true against a single value"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "description": "Exact column name from the dataset summary"
