                          "type": [
                            "string",
                            "number"
                          ]
                        },
                        "description": "Keep rows whose value is any of these"
                      }
                    },
                    "required": [
                      "field",
                      "op",
                      "values"
                    ],
                    "additionalProperties": false,
                    "description": "Keep rows whose value is in a list"
                  }
                ],
                "description": "Applied before aggregation. All filters must hold for a row to be kept."
              }
            },
            "type": {
              "type": "string",
              "const": "line"
            },
            "x": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Exact column name from the dataset summary"
                },
                "label": {
                  "type": "string",
                  "description": "Axis title to show instead of the column name"
                }
              },
              "required": [
                "field"
              ],
              "additionalProperties": false,
              "description": "The x axis. Its scale follows the column kind: dates become a time axis, numbers a linear axis, categories evenly spaced."
            },
            "y": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "aggregate": {
                      "type": "string",
                      "const": "count",
                      "description": "Count the rows"
                    },
                    "label": {
                      "type": "string",
                      "description": "Axis title to show instead of the column name"
                    }
                  },
                  "required": [
                    "aggregate"
                  ],
                  "additionalProperties": false,
                  "description": "Number of rows for each x (and series) value. Takes no field."
                },
                {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "description": "Exact name of a numeric column from the dataset summary"
                    },
                    "aggregate": {
                      "type": "string",
                      "enum": [
                        "sum",
                        "mean",
                        "median",
                        "min",
                        "max"
                      ],
                      "description": "How to combine rows that share the same x (and series) value"
                    },
                    "label": {
                      "type": "string",
                      "description": "Axis title to show instead of the column name"
                    }
                  },
                  "required": [
                    "field",
                    "aggregate"
                  ],
                  "additionalProperties": false,
                  "description": "A numeric column, combined across rows that share the same x (and series) value"
                }
              ],
              "description": "The value axis. Use aggregate \"count\" to count rows; otherwise name a numeric field."
            },
            "series": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Exact name of a category column; at most 12 distinct values"
                }
              },
              "required": [
                "field"
              ],
              "additionalProperties": false,
              "description": "Split into one line, area or bar group per value of this column"
            },
            "annotations": {
              "description": "Up to 5 notes on the chart",
